# WUTT — AI Personal Stylist (Myanmar)
# Copy this to backend/.env and fill in your real values
# NEVER commit .env — only .env.example

# ── App ──────────────────────────────────────────────
DEBUG=true
FRONTEND_URL=http://localhost:5500
DATABASE_URL=sqlite:///./wutt.db

# ── JWT ──────────────────────────────────────────────
JWT_SECRET_KEY=generate-a-random-64-character-string-here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── Browser sessions ─────────────────────────────────
SESSION_COOKIE_NAME=wutt_session
SESSION_EXPIRY_HOURS=168

# ── Temporary Chapter 6 demo login ──────────────────
# Disabled by default. Use one dedicated account; never reuse a real password.
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_EMAIL=demo@example.com
DEMO_LOGIN_PASSWORD=replace-with-a-dedicated-demo-password

# ── Google OAuth (Web application credentials) ───────
# This URI must exactly match an authorized redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-web-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Cloudinary ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here

# ── OpenWeatherMap ───────────────────────────────────
WEATHER_API_KEY=your-weather-key
